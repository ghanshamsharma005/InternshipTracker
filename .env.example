# Example Environment Configuration for InternTrack
# Copy this file to .env and fill in your private values.
# NEVER commit your real .env file with secrets to Git.

# Production Database Connection (e.g. Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Flask Secret Key for Session Security (use a strong random 32+ char key)
SECRET_KEY=change-this-to-a-secure-random-32-char-key

# Session Cookie Security (set to true on production HTTPS)
SESSION_COOKIE_SECURE=false

